<script>
    $navRoute = get_current_route();
    $navTopic = (string) ($_GET['topic'] ?? '');
    $navVersion = PHPueKnowledge::PHPUE_VERSION;
    $navLinks = [
        ['url' => '/',                     'label' => 'Home',         'current' => $navRoute === 'index'],
        ['url' => '/docs',                 'label' => 'Topics',       'current' => $navRoute === 'docs' && $navTopic !== 'ai-rules'],
        ['url' => '/docs?topic=ai-rules',  'label' => 'AI rules',     'current' => $navRoute === 'docs' && $navTopic === 'ai-rules'],
        ['url' => '/skills',               'label' => 'Skills',       'current' => $navRoute === 'skills'],
        ['url' => '/faq',                  'label' => 'FAQ',          'current' => $navRoute === 'faq'],
        ['url' => '/chat',                 'label' => 'Ask AI',       'current' => $navRoute === 'chat'],
        ['url' => '/llms.txt',             'label' => 'llms.txt',     'current' => false],
    ];
</script>

<template>
    <header class="kb-topbar">
        <div class="kb-wrap">
            <a class="kb-brand" href="/">
                <img src="/assets/img/logo-ico.png" alt="" width="30" height="30">
                <span>PHPue AI Knowledge <small>v{{ $navVersion }}</small></span>
            </a>
            <nav class="kb-nav" aria-label="Main">
                <a p-for="$navLink in $navLinks" href="{{ $navLink['url'] }}" aria-current="{{ $navLink['current'] ? 'page' : 'false' }}">{{ $navLink['label'] }}</a>
            </nav>
        </div>
    </header>
</template>
