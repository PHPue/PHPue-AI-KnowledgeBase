                                            <?php endif; ?>
                                            
                                            <?php 
                                            $text = $msg['text'];
                                            // Format code blocks
                                            if (strpos($text, '```') !== false) {
                                                $text = preg_replace_callback('/```([a-z]*)\n(.*?)```/s', function($matches) {
                                                    $lang = $matches[1] ?: 'php';
                                                    $code = htmlspecialchars(trim($matches[2]));
                                                    return '<div class="my-3"><div class="bg-gray-800 text-gray-300 text-sm p-3 rounded-lg overflow-x-auto font-mono"><pre><code class="language-'.$lang.'">'.$code.'</code></pre></div></div>';
                                                }, $text);
                                            }
                                            // Format inline code
                                            $text = preg_replace('/`([^`]+)`/', '<code class="bg-gray-800 px-1 py-0.5 rounded text-sm font-mono">$1</code>', $text);
                                            // Format links
                                            $text = preg_replace('/(https?:\/\/[^\s]+)/', '<a href="$1" target="_blank" class="text-cyan-400 hover:text-cyan-300 underline">$1</a>', $text);
                                            // Format lists
                                            $text = preg_replace('/^\s*•\s*(.+)$/m', '<li class="ml-4">$1</li>', $text);
