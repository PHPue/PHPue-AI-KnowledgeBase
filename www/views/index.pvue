<script>
/**
 * GEMINI + PHPue Chat
 * Enhanced UI/UX with beautiful chat interface
 * A focused chat interface to "Ask Gemini AI about PHPue?"
 */

// Initialize session storage for Gemini chat
if (!isset($_SESSION['gemini_chat'])) {
    $_SESSION['gemini_chat'] = [];
    
    // Add welcome message
    $_SESSION['gemini_chat'][] = [
        'role' => 'assistant',
        'user' => 'Gemini',
        'text' => '👋 Hello! I\'m Gemini, your PHPue AI assistant. Ask me anything about the framework—I can help with components, routing, deployment, or any PHPue-related questions! What would you like to know today?',
        'timestamp' => date('H:i:s'),
        'type' => 'welcome'
    ];
}

// Current user
$currentUser = $_SESSION['current_user'] ?? 'Developer_' . rand(100, 999);
$_SESSION['current_user'] = $currentUser;

// Include Gemini helper
$helperPath = __DIR__ . '/../backend/gemini.php';
if (file_exists($helperPath)) {
    require_once $helperPath;
} else {
    if (!function_exists('callGeminiAPI')) {
        function callGeminiAPI($prompt) {
            return "⚠️ **Configuration Needed**\n\nTo connect to Gemini AI:\n1. Copy `backend/env.example.php` to `backend/env.php`\n2. Add your Gemini API key\n3. Set up your API endpoint\n\nIn the meantime, here's a PHPue tip: Components in the `components/` folder can be reused across views using `@require` statements!";
        }
    }
}

// AJAX: Send message to Gemini
@AJAX('POST')
function sendGeminiMessage($input) {
    if (session_status() === PHP_SESSION_NONE) session_start();

    header('Content-Type: application/json');
    $text = trim($input['message'] ?? '');

    if ($text === '') {
        echo json_encode(['success' => false, 'error' => 'Message cannot be empty']);
        return;
    }

    // Store user message
    $userMsg = [
        'id' => count($_SESSION['gemini_chat']) + 1,
        'role' => 'user',
        'user' => $_SESSION['current_user'] ?? 'Guest',
        'text' => htmlspecialchars($text),
        'timestamp' => date('H:i:s'),
        'avatar_color' => 'from-blue-500 to-cyan-400'
    ];
    $_SESSION['gemini_chat'][] = $userMsg;

    // Get AI response (supports continuation requests)
    try {
        $continue = !empty($input['continue']);
        $continueMsgId = $input['messageId'] ?? null;

        // If this is a continuation request, build prompt from previous assistant message
        if ($continue) {
            $prevText = null;
            foreach ($_SESSION['gemini_chat'] as $m) {
                if ((isset($m['id']) ? $m['id'] : null) == $continueMsgId && $m['role'] === 'assistant') {
                    $prevText = $m['text'];
                    break;
                }
            }

            if ($prevText === null) {
                echo json_encode(['success' => false, 'error' => 'Original message not found for continuation']);
                return;
            }

            $includeDocs = !empty($input['includeDocs']);
            $instruction = $includeDocs ? "Please prefer official PHPue documentation and cite URLs when relevant: https://phpue.co.uk/docs and https://ai.phpue.co.uk. Keep answers concise and include short links as citations." : "";
            $modelPrompt = $instruction . "\n\nContinue and finish the following response, expanding where needed:\n\n" . $prevText;

        } else {
            $includeDocs = !empty($input['includeDocs']);

            // If user asked to prefer & cite docs, add a short instruction to the prompt
            if ($includeDocs) {
                $instruction = "Please prefer official PHPue documentation and cite URLs when relevant: https://phpue.co.uk/docs and https://ai.phpue.co.uk. Keep answers concise and include short links as citations.";
                $modelPrompt = $instruction . "\n\n" . $text;
            } else {
                $modelPrompt = $text;
            }
        }

        $answer = callGeminiAPI($modelPrompt);

        // Heuristic: if very long or ending with ellipses, mark as truncated so UI can offer "Continue"
        $isTruncated = false;
        $plainAnswer = trim(strip_tags($answer));
        if (mb_strlen($plainAnswer) > 1200 || str_ends_with($plainAnswer, '...')) {
            $isTruncated = true;
        }

        $assistantMsg = [
            'id' => count($_SESSION['gemini_chat']) + 1,
            'role' => 'assistant',
            'user' => 'Gemini AI',
            'text' => $answer,
            'timestamp' => date('H:i:s'),
            'avatar_color' => 'from-purple-500 to-pink-500',
            'sources' => $includeDocs ? ['https://phpue.co.uk/docs','https://ai.phpue.co.uk'] : [],
            'truncated' => $isTruncated,
            'continuation_of' => $continue ? $continueMsgId : null
        ];
        $_SESSION['gemini_chat'][] = $assistantMsg;

        echo json_encode([
            'success' => true,
            'message' => $assistantMsg,
            'total_messages' => count($_SESSION['gemini_chat'])
        ]);

    } catch (Throwable $e) {
        @file_put_contents(sys_get_temp_dir() . '/phpue_gemini.log', date('Y-m-d H:i:s') . " - Exception: " . $e->getMessage() . "\n", FILE_APPEND | LOCK_EX);
        echo json_encode(['success' => false, 'error' => 'API Error: ' . $e->getMessage()]);
    }
}

// AJAX: Get chat history
@AJAX('GET')
function getGeminiMessages($input) {
    header('Content-Type: application/json');
    echo json_encode([
        'messages' => $_SESSION['gemini_chat'] ?? [],
        'current_user' => $_SESSION['current_user'] ?? 'Guest'
    ]);
}

// AJAX: Clear chat
@AJAX('POST')
function clearGeminiChat($input) {
    $_SESSION['gemini_chat'] = [[
        'id' => 1,
        'role' => 'assistant',
        'user' => 'Gemini',
        'text' => '👋 Chat cleared! I\'m ready to help with your PHPue questions. What would you like to know?',
        'timestamp' => date('H:i:s'),
        'type' => 'welcome'
    ]];
    echo json_encode(['success' => true, 'message' => 'Chat cleared']);
}

$chatHistory = $_SESSION['gemini_chat'] ?? [];
</script>

