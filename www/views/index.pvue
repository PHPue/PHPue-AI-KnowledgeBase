<script>
/**
 * GEMINI + PHPue Chat
 * A focused chat interface to "Ask Gemini AI about PHPue?"
 * - User messages and LLM responses are stored in PHP sessions
 * - If GEMINI_API_URL and GEMINI_API_KEY are set, an API request will be attempted
 */

// Initialize session storage for Gemini chat
if (!isset($_SESSION['gemini_chat'])) {
    $_SESSION['gemini_chat'] = [];
}

// Current user (simple guest for demo)
$currentUser = $_SESSION['current_user'] ?? 'Guest_' . rand(1000, 9999);
$_SESSION['current_user'] = $currentUser;

// Include centralized Gemini helper so AJAX endpoints can call it reliably
// Ensure path resolves from views directory to backend helper
$helperPath = __DIR__ . '/../backend/gemini.php';
if (file_exists($helperPath)) {
    require_once $helperPath;
} else {
    // If helper is missing, define a fallback to return a clear error message
    if (!function_exists('callGeminiAPI')) {
        function callGeminiAPI($prompt) {
            return "(Gemini helper missing) Please create backend/gemini.php or check file permissions.";
        }
    }
}

// AJAX: Send message to Gemini and store both user + assistant responses in session
@AJAX('POST')
function sendGeminiMessage($input) {
    // Ensure session
    if (session_status() === PHP_SESSION_NONE) session_start();

    header('Content-Type: application/json');

    $text = trim($input['message'] ?? '');

    if ($text === '') {
        http_response_code(400);
        echo json_encode(['success' => false, 'error' => 'Empty message']);
        return;
    }

    // Store user message
    $userMsg = [
        'role' => 'user',
        'user' => $_SESSION['current_user'] ?? 'Guest',
        'text' => htmlspecialchars($text),
        'timestamp' => date('H:i:s')
    ];
    $_SESSION['gemini_chat'][] = $userMsg;

    // Call Gemini (or fallback) and ensure errors are returned as JSON
    try {
        $answer = callGeminiAPI($text);

        // If callGeminiAPI returned an error pattern, include as note but still store reply
        if (is_string($answer) && str_starts_with($answer, '(Gemini error)')) {
            // Log error for debugging
            $logLine = date('Y-m-d H:i:s') . " - Gemini error: " . $answer . "\n";
            @file_put_contents(sys_get_temp_dir() . '/phpue_gemini.log', $logLine, FILE_APPEND | LOCK_EX);

            // Return a clear JSON error so client can display it
            http_response_code(502);
            echo json_encode(['success' => false, 'error' => 'Failed to contact Gemini', 'detail' => $answer]);
            return;
        }

        // Store assistant reply
        $assistantMsg = [
            'role' => 'assistant',
            'user' => 'Gemini',
            'text' => htmlspecialchars($answer),
            'timestamp' => date('H:i:s')
        ];
        $_SESSION['gemini_chat'][] = $assistantMsg;

        echo json_encode([
            'success' => true,
            'userMessage' => $userMsg,
            'assistantMessage' => $assistantMsg
        ]);

    } catch (Throwable $e) {
        // Unexpected server error
        $err = 'Server exception: ' . $e->getMessage();
        @file_put_contents(sys_get_temp_dir() . '/phpue_gemini.log', date('Y-m-d H:i:s') . " - Exception: " . $err . "\n", FILE_APPEND | LOCK_EX);
        http_response_code(500);
        echo json_encode(['success' => false, 'error' => 'Internal server error', 'detail' => $err]);
        return;
    }
}

// AJAX: Get Gemini chat history
@AJAX('GET')
function getGeminiMessages($input) {
    header('Content-Type: application/json');
    echo json_encode([
        'messages' => $_SESSION['gemini_chat'] ?? [],
        'current_user' => $_SESSION['current_user'] ?? 'Guest'
    ]);
}
</script>

<template>
    <div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 p-8">
        <div class="max-w-4xl mx-auto">
            <header class="text-center mb-6">
                <h1 class="text-5xl font-extrabold tracking-tight text-white mb-2">
                    <span class="text-pink-400">PHPue</span> · Ask Gemini
                </h1>
                <p class="text-cyan-300 max-w-2xl mx-auto">A developer-first assistant for PHPue — ask about components, session patterns, setup, and examples. Gemini replies are saved to your PHP session so you can iterate on knowledge while building.</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Main Column -->
                <div class="md:col-span-2 bg-gray-800 rounded-2xl shadow-2xl overflow-hidden border border-cyan-500/20">
                    <div class="bg-gradient-to-r from-pink-600 to-purple-700 px-6 py-4 border-b border-cyan-500/20">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-white font-bold">Gemini · PHPue Assistant</h2>
                                <p class="text-cyan-200 text-sm">Signed in as: <strong>{{ $currentUser }}</strong></p>
                            </div>
                            <div class="flex items-center gap-3">
                                <button class="text-sm text-white/80 hover:text-white px-3 py-1 rounded-md bg-white/5" onclick="refreshGemini()">Refresh 🔄</button>
                                <button class="text-sm text-white/80 hover:text-white px-3 py-1 rounded-md bg-white/5" onclick="exportConversation()">Export ✉️</button>
                            </div>
                        </div>
                    </div>

                    <div id="geminiMessages" class="p-6 h-96 overflow-y-auto bg-gray-900/50">
                        <!-- Inline error banner (hidden unless error) -->
                        <div id="geminiError" class="hidden mb-4 px-4 py-2 bg-red-900/80 text-red-100 rounded-md text-sm"></div>

                        <?php if (empty($_SESSION['gemini_chat'])): ?>
                            <div class="text-center text-gray-500 py-8">
                                <p class="text-5xl mb-2">🤖</p>
                                <p class="text-lg">No conversations yet. Try an example below or ask: "How do I use components in PHPue?"</p>
                            </div>
                        <?php else: ?>
                            <?php foreach ($_SESSION['gemini_chat'] as $m): ?>
                                <div class="mb-4 animate-fade-in">
                                    <div class="flex items-start gap-3 <?php echo ($m['role']==='assistant') ? 'flex-row-reverse' : ''; ?>">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br <?php echo ($m['role']==='assistant') ? 'from-purple-500 to-pink-600' : 'from-cyan-500 to-blue-600'; ?> flex items-center justify-center text-white font-bold">
                                            <?php echo ($m['role']==='assistant') ? 'G' : strtoupper(substr($m['user'],0,1)); ?>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-baseline gap-2 <?php echo ($m['role']==='assistant') ? 'justify-end' : ''; ?>">
                                                <span class="font-bold <?php echo ($m['role']==='assistant') ? 'text-pink-300' : 'text-cyan-400'; ?>"><?php echo htmlspecialchars($m['user']); ?></span>
                                                <span class="text-gray-400 text-xs"><?php echo $m['timestamp']; ?></span>
                                            </div>
                                            <pre class="text-white mt-1 whitespace-pre-wrap bg-gray-900/30 p-3 rounded-lg"><?php
                                                // Don't show large JSON in the UI — if the assistant text looks like raw JSON error, hide details
                                                $text = $m['text'];
                                                if (preg_match('/^\(Gemini\) Unexpected response/i', $text)) {
                                                    echo htmlspecialchars("(Gemini) Unexpected response. Check server logs for details.");
                                                } else {
                                                    echo htmlspecialchars($text);
                                                }
                                            ?></pre>
                                        </div>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </div>

                    <div class="bg-gray-800 px-6 py-4 border-t border-gray-700">
                        <div class="flex flex-col md:flex-row gap-3">
                            <input 
                                id="geminiInput"
                                type="text"
                                placeholder="Ask Gemini about PHPue... (try: 'How do I use components?')"
                                class="flex-1 bg-gray-900 text-white px-4 py-3 rounded-xl border border-gray-700 focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-pink-500/40"
                            />
                            <button id="geminiSend" class="px-6 py-3 bg-gradient-to-r from-pink-500 to-purple-600 hover:from-purple-600 hover:to-pink-500 text-white font-bold rounded-xl shadow-lg transition-all duration-300">Send ✨</button>
                        </div>

                        <div class="mt-3 flex flex-wrap gap-2">
                            <button class="px-3 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded-md text-sm" onclick="usePreset('How do I use components in PHPue?')">Components</button>
                            <button class="px-3 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded-md text-sm" onclick="usePreset('How do I manage sessions in PHPue?')">Sessions</button>
                            <button class="px-3 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded-md text-sm" onclick="usePreset('How do I add a new view or route in PHPue?')">Routing</button>
                            <button class="px-3 py-1 bg-cyan-700 hover:bg-cyan-600 text-white rounded-md text-sm" onclick="usePreset('Where can I find the env.php and configure API keys?')">Env / Keys</button>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <aside class="bg-gray-900 rounded-2xl p-4 border border-gray-700 shadow-lg">
                    <h3 class="text-white font-bold mb-2">Developer Tips</h3>
                    <ul class="text-gray-300 text-sm space-y-2">
                        <li>🔧 Use the example prompts to get quick answers.</li>
                        <li>📚 Visit <a class="text-cyan-300 underline" href="https://phpue.co.uk" target="_blank">phpue.co.uk</a> for docs & examples.</li>
                        <li>🧪 Unsure about API keys? Check <code>www/backend/env.php</code> for local defaults.</li>
                        <li>💾 Conversations are stored in your PHP session; use Export to copy them locally.</li>
                    </ul>

                    <div class="mt-4">
                        <label class="text-gray-300 text-sm">Model / Endpoint</label>
                        <div class="mt-2 flex gap-2">
                            <input id="modelInput" class="flex-1 bg-gray-800 border border-gray-700 text-sm rounded px-3 py-2 text-white" placeholder="e.g. text-bison-001 or gemini-2.5-flash:generateContent" />
                            <button class="px-3 py-2 bg-indigo-600 text-white rounded" onclick="setModel()">Set</button>
                        </div>
                        <p class="text-xs text-gray-500 mt-2">Set a working model endpoint to override env for testing.</p>

                        <div class="mt-4">
                            <h4 class="text-white text-sm font-bold mb-2">Sources</h4>
                            <ul class="text-gray-300 text-xs space-y-1">
                                <li>• <a class="text-cyan-300 underline" href="https://ai.phpue.co.uk" target="_blank">AI Hub</a></li>
                                <li>• <a class="text-cyan-300 underline" href="https://phpue.co.uk/docs" target="_blank">PHPue Docs</a></li>
                            </ul>
                        </div>
                    </div>
                </aside>
            </div>

            <p class="text-sm text-gray-400 mt-6">Tip: Press <kbd class="bg-gray-700 px-1 rounded">Enter</kbd> to send. For production, prefer service-account auth instead of API keys.</p>
        </div>
    </div>
</template>

<cscript>
// Client side: send / fetch Gemini conversation
async function sendToGemini() {
    const input = document.getElementById('geminiInput');
    const msg = input.value.trim();
    if (!msg) return;

    // UI state
    const sendBtn = document.getElementById('geminiSend');
    const messagesContainer = document.getElementById('geminiMessages');
    const errorBanner = document.getElementById('geminiError');

    sendBtn.disabled = true;
    errorBanner.classList.add('hidden');

    // Insert a loading placeholder bubble
    const loadingBubble = document.createElement('div');
    loadingBubble.className = 'mb-4 animate-fade-in';
    loadingBubble.id = 'loadingPlaceholder';
    loadingBubble.innerHTML = `
        <div class="flex items-start gap-3 flex-row-reverse">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white font-bold">G</div>
            <div class="flex-1">
                <div class="flex items-baseline gap-2 justify-end">
                    <span class="font-bold text-pink-300">Gemini</span>
                    <span class="text-gray-400 text-xs">...</span>
                </div>
                <div class="mt-2 text-white/80">
                    <span class="loading-dots">Thinking</span>
                </div>
            </div>
        </div>
    `;
    messagesContainer.appendChild(loadingBubble);
    scrollGeminiToBottom();

    // Small animation on button
    const prevBtnText = sendBtn.innerHTML;
    sendBtn.innerHTML = 'Sending...';

    try {
        const res = await fetch('', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({action: 'sendGeminiMessage', message: msg, modelOverride: actionProxy || null})
        });

        const text = await res.text();
        let data = null;
        try { data = JSON.parse(text); } catch (e) { data = null; }

        if (!res.ok) {
            // Show friendly error in banner and replace loading bubble with a message
            let friendly = 'Server error: ' + res.status;
            if (data && (data.error || data.detail)) {
                friendly = (data.error ? data.error : '') + (data.detail ? (' — ' + data.detail) : '');
            }

            errorBanner.textContent = friendly;
            errorBanner.classList.remove('hidden');

            // Replace loading placeholder with assistant error bubble
            loadingBubble.innerHTML = `
                <div class="flex items-start gap-3 flex-row-reverse">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white font-bold">G</div>
                    <div class="flex-1">
                        <div class="flex items-baseline gap-2 justify-end">
                            <span class="font-bold text-pink-300">Gemini</span>
                            <span class="text-gray-400 text-xs">${new Date().toLocaleTimeString()}</span>
                        </div>
                        <pre class="text-red-200 mt-1 whitespace-pre-wrap bg-red-900/20 p-3 rounded-lg">${escapeHtml(friendly)}</pre>
                    </div>
                </div>
            `;

            scrollGeminiToBottom();
            return;
        }

        // Successful response
        if (data && data.success) {
            input.value = '';
            // Remove loading placeholder and refresh from session for canonical state
            await refreshGemini();
            scrollGeminiToBottom();
        } else {
            // If response contained an error payload
            const errMsg = data ? (data.error || data.detail || JSON.stringify(data)) : text;
            errorBanner.textContent = 'Send failed: ' + (errMsg || 'unknown');
            errorBanner.classList.remove('hidden');

            loadingBubble.innerHTML = `
                <div class="flex items-start gap-3 flex-row-reverse">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white font-bold">G</div>
                    <div class="flex-1">
                        <div class="flex items-baseline gap-2 justify-end">
                            <span class="font-bold text-pink-300">Gemini</span>
                            <span class="text-gray-400 text-xs">${new Date().toLocaleTimeString()}</span>
                        </div>
                        <pre class="text-red-200 mt-1 whitespace-pre-wrap bg-red-900/20 p-3 rounded-lg">${escapeHtml(errMsg)}</pre>
                    </div>
                </div>
            `;
            scrollGeminiToBottom();
        }
    } catch (err) {
        console.error('Network or parse error', err);
        const friendly = 'Network error when contacting server. Check browser DevTools → Network and server logs.';
        const errorBanner = document.getElementById('geminiError');
        errorBanner.textContent = friendly;
        errorBanner.classList.remove('hidden');

        loadingBubble.innerHTML = `
            <div class="flex items-start gap-3 flex-row-reverse">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white font-bold">G</div>
                <div class="flex-1">
                    <div class="flex items-baseline gap-2 justify-end">
                        <span class="font-bold text-pink-300">Gemini</span>
                        <span class="text-gray-400 text-xs">${new Date().toLocaleTimeString()}</span>
                    </div>
                    <pre class="text-red-200 mt-1 whitespace-pre-wrap bg-red-900/20 p-3 rounded-lg">${escapeHtml(friendly)}</pre>
                </div>
            </div>
        `;
        scrollGeminiToBottom();
    } finally {
        sendBtn.disabled = false;
        sendBtn.innerHTML = prevBtnText;
    }
}

async function refreshGemini() {
    try {
        const res = await fetch('?action=getGeminiMessages', {method: 'GET'});
        const data = await res.json();

        const container = document.getElementById('geminiMessages');
        container.innerHTML = '';

        if (!data.messages || data.messages.length === 0) {
            container.innerHTML = `
                <div class="text-center text-gray-500 py-8">
                    <p class="text-4xl mb-2">🤖</p>
                    <p>No conversations yet. Ask: "How can I use PHPue with components?"</p>
                </div>
            `;
            return;
        }

        data.messages.forEach(m => {
            const wrapper = document.createElement('div');
            wrapper.className = 'mb-4 animate-fade-in';
            wrapper.innerHTML = `
                <div class="flex items-start gap-3 ${m.role==='assistant' ? 'flex-row-reverse' : ''}">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-br ${m.role==='assistant' ? 'from-purple-500 to-pink-600' : 'from-cyan-500 to-blue-600'} flex items-center justify-center text-white font-bold">
                        ${m.role==='assistant' ? 'G' : m.user.charAt(0).toUpperCase()}
                    </div>
                    <div class="flex-1">
                        <div class="flex items-baseline gap-2 ${m.role==='assistant' ? 'justify-end' : ''}">
                            <span class="font-bold ${m.role==='assistant' ? 'text-pink-400' : 'text-cyan-400'}">${m.user}</span>
                            <span class="text-gray-500 text-xs">${m.timestamp}</span>
                        </div>
                        <pre class="text-white mt-1 whitespace-pre-wrap bg-gray-900/30 p-3 rounded-lg">${m.text}</pre>
                    </div>
                </div>
            `;
            container.appendChild(wrapper);
        });
    } catch (err) {
        console.error('Refresh error', err);
    }
}

function scrollGeminiToBottom() {
    const c = document.getElementById('geminiMessages');
    c.scrollTop = c.scrollHeight;
}

// Bind events
document.getElementById('geminiSend').addEventListener('click', sendToGemini);
document.getElementById('geminiInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendToGemini();
});

actionProxy = null; // optional model override

function usePreset(text) {
    const input = document.getElementById('geminiInput');
    input.value = text;
    input.focus();
}

async function exportConversation() {
    try {
        const res = await fetch('?action=getGeminiMessages');
        const data = await res.json();
        const lines = data.messages.map(m => `${m.timestamp} | ${m.user}: ${m.text}`);
        const blob = new Blob([lines.join('\n')], { type: 'text/plain' });
        await navigator.clipboard.writeText(lines.join('\n'));
        alert('Conversation copied to clipboard!');
    } catch (err) {
        console.error('Export failed', err);
        alert('Failed to export conversation. Check console for details.');
    }
}

function setModel() {
    const v = document.getElementById('modelInput').value.trim();
    if (!v) {
        alert('Enter a model endpoint or model name first');
        return;
    }
    // allow quick test override via query param style proxy
    actionProxy = v;
    alert('Model override set for this session (works client-side only).');
}

// Helpers
function escapeHtml(unsafe) {
    return unsafe
         .replace(/&/g, "&amp;")
         .replace(/</g, "&lt;")
         .replace(/>/g, "&gt;")
         .replace(/"/g, "&quot;")
         .replace(/'/g, "&#039;");
}

// Small loading-dots animation via CSS injection
const style = document.createElement('style');
style.innerHTML = `
@keyframes dots { 0% { content: ''; } 33% { content: '.';} 66% { content: '..'} 100% { content: '...'} }
.loading-dots::after { content: ''; display: inline-block; width: 1.2rem; text-align: left; animation: dots 1s steps(3) infinite; }
`;
document.head.appendChild(style);

// Initial load
refreshGemini().then(scrollGeminiToBottom);
</cscript>