                        </div>
                        <div class="flex items-start gap-2">
                            <div class="w-6 h-6 bg-purple-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                                <span class="text-purple-300 text-sm">🚀</span>
                            </div>
                            <p class="text-gray-300 text-sm">Deploy with <code class="bg-gray-800 px-1 rounded text-xs">?build=1</code> for production</p>
                        </div>
                        <div class="flex items-start gap-2">
                            <div class="w-6 h-6 bg-purple-500/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                                <span class="text-purple-300 text-sm">🎯</span>
                            </div>
                            <p class="text-gray-300 text-sm">Check <code class="bg-gray-800 px-1 rounded text-xs">backend/env.php</code> for API config</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</template>

<cscript>
// Enhanced client-side functionality
let isProcessing = false;
let messageCount = <?php echo count($chatHistory); ?>;

// Send message to Gemini
async function sendMessage() {
    if (isProcessing) return;
    
    const input = document.getElementById('geminiInput');
    const message = input.value.trim();
    const sendBtn = document.getElementById('sendButton');
    const errorBanner = document.getElementById('errorBanner');
    
    if (!message) {
        showError('Please enter a message');
        input.focus();
        return;
    }
    
    // Clear previous errors
    errorBanner.classList.add('hidden');
    
    // Update UI state
    isProcessing = true;
    const originalText = sendBtn.innerHTML;
    sendBtn.innerHTML = `
        <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Processing...
    `;
    sendBtn.disabled = true;
    
    // Add user message immediately
    addMessageToUI('user', message);
    input.value = '';
    scrollToBottom();
    
    // Add typing indicator
    const typingId = addTypingIndicator();
    
    try {
        const response = await fetch('', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'sendGeminiMessage',
                message: message,
                includeDocs: document.getElementById('includeDocs') ? !!document.getElementById('includeDocs').checked : false
            })
        });
        
        const data = await response.json();
        
        // Remove typing indicator
        removeTypingIndicator(typingId);
        
        if (data.success) {
            // Add AI response
            addMessageToUI('assistant', data.message.text, data.message);
            messageCount += 2;
            updateStats();
        } else {
            showError(data.error || 'Failed to get response');
            // Add error message
            addMessageToUI('assistant', '⚠️ **Error**\n\n' + (data.error || 'Unable to process your request. Please try again.'));
        }
        
    } catch (error) {
        removeTypingIndicator(typingId);
        showError('Network error: ' + error.message);
        addMessageToUI('assistant', '⚠️ **Network Error**\n\nPlease check your connection and try again.');
    } finally {
        // Reset UI
        isProcessing = false;
        sendBtn.innerHTML = originalText;
        sendBtn.disabled = false;
        scrollToBottom();
    }
}

// Continue a message (truncated response)
async function continueMessage(messageId) {
    if (isProcessing) return;
    
    const continueBtn = document.querySelector(`.continue-btn[data-msg-id="${messageId}"]`);
    if (continueBtn) continueBtn.disabled = true;
    
    isProcessing = true;
    
    try {
        const response = await fetch('', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: 'sendGeminiMessage',
                continue: true,
                messageId: messageId,
                includeDocs: document.getElementById('includeDocs') ? !!document.getElementById('includeDocs').checked : false
            })
        });
        
        const data = await response.json();
        
        if (data.success) {
            // Add continuation message
            addMessageToUI('assistant', data.message.text, data.message);
            messageCount++;
            updateStats();
        } else {
            showError('Failed to continue: ' + (data.error || 'Unknown error'));
        }
        
    } catch (error) {
        showError('Network error: ' + error.message);
    } finally {
        isProcessing = false;
        if (continueBtn) continueBtn.disabled = false;
        scrollToBottom();
    }
}

// Add message to UI
function addMessageToUI(role, text, data = null) {
    const container = document.getElementById('geminiMessages');
    const messageId = 'msg-' + Date.now();
    const timestamp = data?.timestamp || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const user = role === 'user' ? (data?.user || 'You') : 'Gemini AI';
    
    const messageDiv = document.createElement('div');
    messageDiv.id = messageId;
    messageDiv.className = 'message-item animate-fade-in ' + (role === 'user' ? 'ml-auto' : '');
    messageDiv.style.maxWidth = '85%';
    
    // Format text with markdown-like features
    let formattedText = text
        .replace(/```([a-z]*)\n([\s\S]*?)```/g, (match, lang, code) => 
            `<div class="my-3"><div class="bg-gray-800 text-gray-300 text-sm p-3 rounded-lg overflow-x-auto font-mono"><pre><code>${escapeHtml(code.trim())}</code></pre></div></div>`
        )
        .replace(/`([^`]+)`/g, '<code class="bg-gray-800 px-1 py-0.5 rounded text-sm font-mono">$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold">$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em class="italic">$1</em>')
        .replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" class="text-cyan-400 hover:text-cyan-300 underline">$1</a>')
        .replace(/\n/g, '<br>');
    
    messageDiv.innerHTML = `
        <div class="flex gap-3 ${role === 'user' ? 'flex-row-reverse' : ''}">
            <div class="flex-shrink-0">
                <div class="w-10 h-10 rounded-full bg-gradient-to-r ${role === 'assistant' ? 'from-purple-500 to-pink-500' : 'from-blue-500 to-cyan-400'} flex items-center justify-center shadow-lg">
                    <span class="text-white font-bold">${role === 'assistant' ? 'G' : user.charAt(0)}</span>
                </div>
            </div>
            <div class="flex-1">
                <div class="flex items-baseline gap-2 mb-1 ${role === 'user' ? 'justify-end' : ''}">
                    <span class="font-bold ${role === 'assistant' ? 'text-purple-300' : 'text-blue-300'}">${user}</span>
                    <span class="text-xs text-gray-500">${timestamp}</span>
                </div>
                <div class="${role === 'user' 
                    ? 'bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-2xl rounded-tr-none' 
                    : 'bg-gray-900/80 text-gray-100 rounded-2xl rounded-tl-none border border-gray-700/50'} p-4 shadow-lg">
                    <div class="message-content" data-msg-id="${data?.id || messageId}">
                        ${formattedText}
                    </div>
                    ${data && data.sources && data.sources.length ? `<div class="mt-3 text-xs text-gray-400 border-t border-gray-700/30 pt-2">Sources: ${data.sources.map(s => `<a href="${s}" target="_blank" class="text-cyan-300 underline">${s}</a>`).join(', ')}</div>` : ''}
                    ${data && data.truncated ? `<div class="message-actions mt-2 text-right"><button class="continue-btn px-2 py-1 text-xs text-cyan-300 rounded hover:bg-gray-800/30" data-msg-id="${data.id}" onclick="continueMessage(${data.id})">Continue</button></div>` : ''}
                </div>
            </div>
        </div>
    `;
    
    container.appendChild(messageDiv);
    return messageId;
}

// Add typing indicator
function addTypingIndicator() {
    const container = document.getElementById('geminiMessages');
    const typingId = 'typing-' + Date.now();
    
    const typingDiv = document.createElement('div');
    typingDiv.id = typingId;
    typingDiv.className = 'message-item';
    typingDiv.style.maxWidth = '85%';
    
    typingDiv.innerHTML = `
        <div class="flex gap-3">
            <div class="flex-shrink-0">
                <div class="w-10 h-10 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 flex items-center justify-center shadow-lg">
                    <span class="text-white font-bold">G</span>
                </div>
            </div>
            <div class="flex-1">
                <div class="flex items-baseline gap-2 mb-1">
                    <span class="font-bold text-purple-300">Gemini AI</span>
                    <span class="text-xs text-gray-500">typing...</span>
                </div>
                <div class="bg-gray-900/80 text-gray-100 rounded-2xl rounded-tl-none border border-gray-700/50 p-4 shadow-lg">
                    <div class="flex items-center gap-1">
                        <div class="w-2 h-2 bg-purple-400 rounded-full animate-bounce" style="animation-delay: 0s"></div>
                        <div class="w-2 h-2 bg-purple-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                        <div class="w-2 h-2 bg-purple-400 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    container.appendChild(typingDiv);
    scrollToBottom();
    return typingId;
}

function removeTypingIndicator(id) {
    const element = document.getElementById(id);
    if (element) element.remove();
}

// Clear chat
async function clearChat() {
    if (!confirm('Clear all chat messages? This action cannot be undone.')) return;
    
    try {
        const response = await fetch('', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'clearGeminiChat' })
        });
        
        const data = await response.json();
        if (data.success) {
            const container = document.getElementById('geminiMessages');
            container.innerHTML = '';
            
            // Add welcome message
            addMessageToUI('assistant', '👋 Chat cleared! I\'m ready to help with your PHPue questions. What would you like to know?');
            messageCount = 1;
            updateStats();
            scrollToBottom();
        }
    } catch (error) {
        showError('Failed to clear chat: ' + error.message);
    }
}

// Export chat
async function exportChat() {
    try {
        const response = await fetch('?action=getGeminiMessages');
        const data = await response.json();
        
        const markdown = data.messages.map(msg => {
            const time = msg.timestamp;
            const user = msg.user;
            const text = msg.text.replace(/```/g, '\`\`\`');
            return `**${user}** (${time}):\n${text}\n\n---\n`;
        }).join('\n');
        
        const blob = new Blob([markdown], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `phpue-chat-${new Date().toISOString().split('T')[0]}.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        
        // Show success notification
        showNotification('Chat exported successfully!');
        
    } catch (error) {
        showError('Failed to export chat: ' + error.message);
    }
}

// Helper functions
function setPrompt(text) {
    const input = document.getElementById('geminiInput');
    input.value = text;
    input.focus();
    input.scrollIntoView({ behavior: 'smooth' });
}

function showError(message) {
    const errorBanner = document.getElementById('errorBanner');
    errorBanner.textContent = message;
    errorBanner.classList.remove('hidden');
    
    // Auto-hide after 5 seconds
    setTimeout(() => {
        errorBanner.classList.add('hidden');
    }, 5000);
}

function showNotification(message) {
    // Create notification element
    const notification = document.createElement('div');
    notification.className = 'fixed bottom-4 right-4 bg-green-600 text-white px-4 py-3 rounded-xl shadow-xl z-50 animate-slide-in';
    notification.textContent = message;
    document.body.appendChild(notification);
    
    // Remove after 3 seconds
    setTimeout(() => {
        notification.classList.add('animate-fade-out');
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

function showConfigHelp() {
    const helpText = `## 🔧 Gemini API Configuration\n\nTo connect to Gemini AI:\n\n1. Copy \`backend/env.example.php\` to \`backend/env.php\`\n2. Add your Gemini API key:\n   \`\`\`php\ndefine('GEMINI_API_KEY', 'your-api-key-here');\n\`\`\`\n3. Set the API endpoint (optional)\n\nYou can get a free API key from Google AI Studio.`;
    
    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 animate-fade-in';
    modal.innerHTML = `
        <div class="bg-gray-800 rounded-2xl max-w-lg w-full border border-gray-700 shadow-2xl">
            <div class="p-6 border-b border-gray-700">
                <div class="flex items-center justify-between">
                    <h3 class="text-xl font-bold text-white flex items-center gap-2">
                        <span class="text-green-400">⚙️</span> Setup Guide
                    </h3>
                    <button onclick="this.closest('.fixed').remove()" class="text-gray-400 hover:text-white">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="p-6 text-gray-300 prose prose-invert max-w-none">
                ${helpText.replace(/\n/g, '<br>')}
            </div>
            <div class="p-6 border-t border-gray-700 flex justify-end">
                <button onclick="this.closest('.fixed').remove()" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 rounded-xl text-white">
                    Got it!
                </button>
            </div>
        </div>
    `;
    document.body.appendChild(modal);
}

function scrollToBottom() {
    const container = document.getElementById('geminiMessages');
    container.scrollTop = container.scrollHeight;
}

function updateStats() {
    // Update stats in real-time if needed
    console.log(`Total messages: ${messageCount}`);
}

function voiceInput() {
    showNotification('Voice input coming soon! 🎤');
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Event listeners
document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('geminiInput');
    const sendBtn = document.getElementById('sendButton');
    
    // Enter to send
    input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });
    
    // Focus input on load
    setTimeout(() => input.focus(), 300);
    
    // Add CSS animations
    const style = document.createElement('style');
    style.textContent = `
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes fadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }
        .animate-fade-in { animation: fadeIn 0.3s ease-out; }
        .animate-slide-in { animation: slideIn 0.3s ease-out; }
        .animate-fade-out { animation: fadeOut 0.3s ease-out; }
        .animate-bounce { animation: bounce 0.6s infinite; }
        .message-item { transition: all 0.3s ease; }
        .message-item:hover { transform: translateY(-2px); }
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(to bottom, #8b5cf6, #ec4899);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(to bottom, #7c3aed, #db2777);
        }

        /* Collapse / Read more styles */
        .message-content { transition: max-height 0.25s ease; overflow: visible; }
        .message-content.collapsed { max-height: 160px; overflow: hidden; }
        .message-content.expanded { max-height: none; }
        .read-more-btn { background: transparent; border: 1px solid rgba(255,255,255,0.04); color: #cbd5e1; cursor: pointer; }
        .continue-btn { background: transparent; border: none; color: #06b6d4; cursor: pointer; }
    `;
    document.head.appendChild(style);
});

// Export functions for button onclick handlers
window.sendMessage = sendMessage;
window.clearChat = clearChat;
window.exportChat = exportChat;
window.setPrompt = setPrompt;
window.voiceInput = voiceInput;
window.showConfigHelp = showConfigHelp;
window.continueMessage = continueMessage;
</cscript>