<script>
    // No props needed: this component is inlined, so it inherits the parent's variables (here the loop's $cardProduct). Default them anyway.
    $cardProduct = (isset($cardProduct) && is_array($cardProduct)) ? $cardProduct : [];
    $cardBadge   = $cardBadge ?? null;
    // No named functions/classes here (component may render many times); use closures or backend/.
    $cardPrice   = fn($pence) => '£' . number_format(((int)$pence) / 100, 2);
</script>

<template>
    <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" data-id="{{ $cardProduct['id'] ?? '' }}">
        <h3 class="font-semibold">{{ $cardProduct['name'] ?? '' }}</h3>
        <p class="text-sm text-slate-600"><?= htmlspecialchars($cardPrice($cardProduct['price'] ?? 0)) ?></p>
        <span p-if="$cardBadge !== null" class="mt-2 inline-block rounded-full bg-emerald-100 px-2 text-xs text-emerald-700">
            {{ $cardBadge }}
        </span>
    </article>
</template>
